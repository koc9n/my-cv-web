NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Local Docker default; replace with the managed production URL on Vercel.
DATABASE_URL=postgresql://mycv:mycv_local@localhost:5432/mycv
AUTH_SECRET=replace-with-a-long-random-secret
# Use the "my-cv-web development" Google OAuth web client locally.
# Origin: http://localhost:3000
# Callback: http://localhost:3000/api/auth/callback/google
# In production, replace both values with a separate production client whose
# origin and callback use the final HTTPS hostname.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact verified Google email allowed to access /admin.
ADMIN_EMAIL=
# Preview deployments deny admin access unless explicitly enabled.
ENABLE_PREVIEW_ADMIN=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_CONTACT_EMAIL=
# Public profile opened by the Telegram contact action.
PUBLIC_TELEGRAM_URL=https://t.me/USERNAME
