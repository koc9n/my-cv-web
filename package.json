{
  "name": "my-cv-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/deploy-migrations.mjs && next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/server/cv-repository.integration.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:local": "node --env-file=.env.local ./node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "prisma studio",
    "db:studio:local": "node --env-file=.env.local ./node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "^4.5.1",
    "docx": "^9.7.1",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "postcss": "8.5.20",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.5",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.20",
    "uuid": "11.1.1"
  }
}
